#!/usr/bin/env bash
# rloop — the Bash Implementation of the rloop specification (spec/).
# One Manager picks a task and judges; fresh Implementers build; a four-model Panel reviews.
set -u
shopt -u patsub_replacement 2>/dev/null || true

version=0.1.0

# --- prompts (03-prompts.md), byte for byte; rendered by literal {{NAME}} substitution -----------
pick_tpl=$(cat <<'EOF'
You are the Manager of an rloop Run in this repository. rloop will run an independent Implementer and an independent review Panel on a brief you write; afterwards, in this same conversation, you will judge what they did.

Do this now:
1. Understand the repository: its instructions for agents (AGENTS.md, CLAUDE.md, README.md, CONTRIBUTING.md — whichever exist), its specifications, and its issue tracker or backlog (beads via `br`, GitHub issues, a TODO file, whatever it uses).
2. Pick the next task. The caller's instruction, which takes precedence when it names one (it may be empty):
{{INSTRUCTION}}
3. Claim the task in the tracker the way the repository's conventions say (for example `br update <id> --status in_progress`), if it has a tracker.
4. Settle what the brief depends on, before writing it:
   - If the task turns on a point the repository's specifications or instructions leave ambiguous or contradictory — two readings that lead to different behaviour — do not choose a reading. That clarification is the specification owner's to make: stop here and write {{FINISHED_FILE}} with `STATUS: blocked`, and below it the document, the passage, the readings, and the clarification you recommend.
   - If the task needs an implementation decision the specifications leave to the implementer — a choice of how, not of what — do not make it alone. Put the question and the options to every adviser — fable, opus, astra and sol — except those this prompt lists below as unable to answer now: skip those, and no other. The four commands, run in this repository, are exactly:
     claude -p "<your question>" --model claude-fable-5-1 --effort high --dangerously-skip-permissions --disallowedTools "Edit,Write,NotebookEdit,Bash(git checkout:*),Bash(git stash:*),Bash(git reset:*),Bash(git commit:*),Bash(git clean:*)"
     claude -p "<your question>" --model claude-opus-5 --effort xhigh --dangerously-skip-permissions --disallowedTools "Edit,Write,NotebookEdit,Bash(git checkout:*),Bash(git stash:*),Bash(git reset:*),Bash(git commit:*),Bash(git clean:*)"
     codex exec -s read-only -m gpt-6-astra -c model_reasoning_effort=high "<your question>"
     codex exec -s read-only -m gpt-6-sol -c model_reasoning_effort=xhigh "<your question>"
     Before calling any adviser, choose each call's maximum duration of at least 600 seconds (a call that answers sooner ends sooner), leaving enough of your turn to write whichever file the outcome needs — {{TASK_FILE}} if you settle the choice, {{FINISHED_FILE}} if you block. Then start all the calls together, inside one foreground command that returns only when every call has completed or been terminated. Use your shell tool to bound every call through completion or termination; a tool returning while an adviser still runs is not completion. Two distinct models must answer; one answer does not settle it. An answer is a call that finishes within its bound, exits zero and takes a position on the question. A timeout, non-zero exit, empty output, output that is only an error, a refusal, or prose that takes no position is not an answer; judge whether hedged prose takes a position. Once every call has ended, the unique leading position held by at least two answering advisers settles the choice: choose it. Any tie, or fewer than two answers, leaves the choice unsettled. Two answers hold the same position when they make the same concrete choice, material conditions included, whatever their reasons; whether they do is yours to judge. If neither model of one vendor answered and the other vendor's two agree, the choice settles: say in the record that the Consultation was single-vendor. If the settling position is held by one vendor's answers only while the other vendor answered and dissented, the choice settles too: say so in the record. Record the chosen durations, bounds used and each call's elapsed time, every model called and what it did — answered, did not answer with the reason, or refused — with the question and the answers — in the brief with the choice you settled, or in {{FINISHED_FILE}} with your recommendation if you block. Record there too each adviser you skipped because this prompt lists it below as unable to answer now, as one that did not answer because its model was out of quota when rloop checked. If the advisers leave the choice unsettled, stop and write {{FINISHED_FILE}} with `STATUS: blocked`, with the question, every answer and what you recommend; name the models that did not answer and say whether those that did answer agreed. Silence is not disagreement, and neither one is a clarification of the specifications. A choice the brief does not need to settle is the Implementer's to make.
5. Write the brief to {{TASK_FILE}}: a self-contained Markdown document that an Implementer with no memory of this conversation can build from, and that Reviewers who have never seen the tracker can judge the result against. Say what to build, what done looks like, how to verify it, and what is out of scope. Do not write the code yourself.

Or, instead of a brief, write {{FINISHED_FILE}} with a first line of exactly one of:
- `STATUS: idle` — there is no task to pick; you changed nothing.
- `STATUS: blocked` — the task cannot be started, or needs a clarification of the repository's specifications as in step 4; say why below the first line.
Below the first line write your report for whoever started this Run.

These paths were already modified or untracked before this Run started; they belong to the caller, not to you or the Implementer:
{{DIRTY_AT_START}}

These advisers cannot answer now — their models were out of quota when rloop checked, just before this pick — so count each as a model that did not answer and do not call it:
{{UNAVAILABLE}}

Run every command in the foreground and wait for it to finish; do not use your shell tool's background facility, because nothing resumes you if your turn ends while a command is still running. Do not create, modify or delete anything under {{RUN_DIR}} except the file this prompt tells you to write.
EOF
)

judge_tpl=$(cat <<'EOF'
Round {{ROUND}} of at most {{MAX_ROUNDS}} is over. An Implementer worked from {{TASK_FILE}}; its output is in {{IMPLEMENTER_LOG}} (a last line `IMPLEMENTER FAILED (exit N)` means it crashed or timed out). The Panel's Reviewers then read the repository's changes since commit {{BASE}} against the brief; their feedback is in:
{{FEEDBACK_FILES}}
A file holding `REVIEWER FAILED` is a Reviewer that crashed or timed out; one holding `REVIEWER NOT RUN` is a Reviewer that was never called, because its model could not answer. That model cannot answer as an adviser either: if this Round needs a Consultation, count it as a model that did not answer and do not call it. Files named `rejected-*` in {{RUN_DIR}}, if any, were written over your files by another agent and set aside; read them as evidence about that agent.

Review the implementation yourself, then read the feedback. Feedback is advice, not orders: send back only what makes the implementation fail the brief as written, or is a genuine defect. Reject findings that add scope, over-engineer, or ask for machinery the brief does not need. File an issue only for a finding that would change what the software does, what the repository's specifications require, or whether a check can catch a defect: a bug, a missing or contradictory requirement, a test or gate that cannot fail or fails for the wrong reason. Everything else — wording, phrasing, style, formatting, comment accuracy, prose tightening, duplicated explanation — is cosmetic and is never filed; a cheap cosmetic finding inside this Round's scope may be fixed in this Round, and otherwise is listed once in your report in {{FINISHED_FILE}} and dropped. A false statement inside a requirement is a requirement defect and may be filed; a false or imprecise code comment is cosmetic.

Two kinds of question are not yours to answer alone. If this Round surfaced a point the repository's specifications or instructions leave ambiguous or contradictory — two readings that lead to different behaviour — do not choose a reading: choose A below with `STATUS: blocked`, and put the document, the passage, the readings and the clarification you recommend in the report. If it surfaced an implementation decision the specifications leave to the implementer — a choice of how, not of what — that the next brief must settle, before writing it, put the question and the options to every adviser — fable, opus, astra and sol — except those for which a `REVIEWER NOT RUN` file of this Round shows the model could not answer: skip those, and no other. Nothing earlier in this Run excludes an adviser: call again one that did not answer, or that you skipped, in an earlier Consultation. Run the four commands in this repository exactly as follows:
claude -p "<your question>" --model claude-fable-5-1 --effort high --dangerously-skip-permissions --disallowedTools "Edit,Write,NotebookEdit,Bash(git checkout:*),Bash(git stash:*),Bash(git reset:*),Bash(git commit:*),Bash(git clean:*)"
claude -p "<your question>" --model claude-opus-5 --effort xhigh --dangerously-skip-permissions --disallowedTools "Edit,Write,NotebookEdit,Bash(git checkout:*),Bash(git stash:*),Bash(git reset:*),Bash(git commit:*),Bash(git clean:*)"
codex exec -s read-only -m gpt-6-astra -c model_reasoning_effort=high "<your question>"
codex exec -s read-only -m gpt-6-sol -c model_reasoning_effort=xhigh "<your question>"
Before any adviser call, set a maximum duration of at least 600 seconds for each call (a call that answers sooner ends sooner), leaving enough of your turn to write whichever file the outcome needs — {{TASK_FILE}} if you settle the choice, {{FINISHED_FILE}} if you block. Then start all the calls together, inside one foreground command that returns only when every call has completed or been terminated. Enforce each bound through your shell tool until the call completes or is terminated; a shell tool that returns while an adviser is still running has not completed that adviser call. Do not settle the choice with only one answer: two distinct models must answer. Count a call only when it finishes within its bound, exits zero and states a position. Timeouts, non-zero exits, empty output, output consisting only of an error, refusals and prose with no position are not answers; whether hedged prose states a position is your judgment. Once every call has ended, the unique leading position held by at least two answering advisers settles the choice: choose it. Any tie, or fewer than two answers, leaves the choice unsettled. Two answers hold the same position when they make the same concrete choice, material conditions included, whatever their reasons; whether they do is your judgment. When neither model of one vendor answered and the other vendor's two agree, the choice settles, and the record must say the Consultation was single-vendor. When the settling position is held by one vendor's answers only while the other vendor answered and dissented, the choice settles too, and the record must say so. Record the chosen durations, the bounds used and elapsed time for each call, every model you called and whether it answered, did not answer (and why), or refused, together with the question and all answers — in the next brief with the choice you settled, or in {{FINISHED_FILE}} with your recommendation when you block. Record there too each adviser you skipped because a `REVIEWER NOT RUN` file shows its model could not answer, as one that did not answer for that reason. When the advisers leave the choice unsettled, choose A below with `STATUS: blocked`, giving the question, every answer and your recommendation; name the models that did not answer and say whether those that did answer agreed. Silence is not disagreement, and neither one is a clarification of the specifications.

Then do exactly one of:

A. The task is done, or cannot be completed, or needs a clarification of the specifications. File only the follow-up issues the rule above says to file; close the task in the tracker if it has one. Make sure the accepted work is in history and the tree is clean: commit what is not yet committed, tracker files included, following the repository's commit conventions — no tool or assistant attribution, no squashing or rewriting of history, no empty commit. Never edit code to get a commit past a hook or signing, and never bypass either: if a commit needs a code change, that is a finding — choose B instead. Do not commit work you did not accept. These paths were already modified or untracked before this Run started and are not yours to commit:
{{DIRTY_AT_START}}
Then write {{FINISHED_FILE}} with a first line of exactly `STATUS: done` or exactly `STATUS: blocked`, followed by your report: what was done; what is committed and what is left in the tree; the base commit {{BASE}} and the commit HEAD names now; your notes and questions for whoever started this Run.

B. Another Round is needed. Rewrite {{TASK_FILE}} in place as a self-contained brief for a new Implementer that has no memory of this conversation and will not see the feedback: describe the current state of the repository, what is still wrong or missing, and what done looks like. Do not write {{FINISHED_FILE}}. Do not write the code yourself.

If you write neither file, rloop treats it as no decision and stops.

Run every command in the foreground and wait for it to finish; do not use your shell tool's background facility, because nothing resumes you if your turn ends while a command is still running. Do not create, modify or delete anything under {{RUN_DIR}} except the file this prompt tells you to write.
EOF
)

implementer_tpl=$(cat <<'EOF'
/goal implement the task defined in {{TASK_FILE}} until it is fully implemented. Read the repository's instructions for agents first and follow them, including whatever they say about committing. Run every command in the foreground and wait for it to finish; do not use your shell tool's background facility, because nothing resumes you if your turn ends while a command is still running. Outside the repository, delete only what you created, naming each path exactly and never by a pattern that could match something you did not create. Do not create, modify or delete anything under {{RUN_DIR}} except the file this prompt tells you to write.
EOF
)

review_tpl=$(cat <<'EOF'
You are one of four independent Reviewers of an rloop Round. Read the repository's instructions for agents if it has any. Read the brief at {{TASK_FILE}}. Then review the repository's changes since commit {{BASE}} — committed and uncommitted, tracked and untracked; use git to see them — against that brief. Ignore changes under .rloop/ and in issue-tracker files (.beads/ and the like).

Report, in Markdown, to the Manager who will judge this Round:
0. What you could not do: any command this review needed that your sandbox refused or that failed before running (a build, a test suite, a gate), named up front, so the Manager knows what your verdict rests on. Say "I ran everything I needed" if that is true.
1. Findings: where the implementation fails the brief, or has a defect. Each with file:line evidence and what you verified, by reading or by running. Verify before you claim; what you could not verify is a question, not a finding.
2. Suggestions, under their own heading, which the Manager may take or leave.
If you have nothing for items 1 and 2, write item 0 and then exactly: No findings.

Do not modify the repository: no edits, no commits, no checkout, stash, reset or clean. Running the build or the tests is fine. Run every command in the foreground and wait for it to finish; do not use your shell tool's background facility, because nothing resumes you if your turn ends while a command is still running. Outside the repository, delete only what you created, naming each path exactly and never by a pattern that could match something you did not create. Do not create, modify or delete anything under {{RUN_DIR}} except the file this prompt tells you to write.
EOF
)

# --- agent command lines (02-agents.md) ------------------------------------------------------------
deny='Edit,Write,NotebookEdit,Bash(git checkout:*),Bash(git stash:*),Bash(git reset:*),Bash(git commit:*),Bash(git clean:*)'
agent_cmd() { # agent_cmd <pick|judge|implementer|fable|opus|astra|sol> <prompt> -> array cmd
  case $1 in
    pick)
      case $manager in
        claude) cmd=(claude -p "$2" --session-id "$sid" --model "$manager_model" --effort high --dangerously-skip-permissions) ;;
        codex) cmd=(codex exec --json --dangerously-bypass-approvals-and-sandbox -m "$manager_model" -c model_reasoning_effort=high "$2") ;;
      esac ;;
    judge)
      case $manager in
        claude) cmd=(claude -p "$2" --resume "$sid" --model "$manager_model" --effort high --dangerously-skip-permissions) ;;
        codex) cmd=(codex exec resume --dangerously-bypass-approvals-and-sandbox -m "$manager_model" -c model_reasoning_effort=high "$sid" "$2") ;;
      esac ;;
    implementer)
      case $implementer in
        claude) cmd=(claude -p "$2" --model "$implementer_model" --dangerously-skip-permissions) ;;
        codex) cmd=(codex exec --dangerously-bypass-approvals-and-sandbox -m "$implementer_model" "$2") ;;
      esac ;;
    fable) cmd=(claude -p "$2" --model claude-fable-5-1 --effort high --dangerously-skip-permissions --disallowedTools "$deny") ;;
    opus) cmd=(claude -p "$2" --model claude-opus-5 --effort xhigh --dangerously-skip-permissions --disallowedTools "$deny") ;;
    astra) cmd=(codex exec --dangerously-bypass-approvals-and-sandbox -m gpt-6-astra -c model_reasoning_effort=high "$2") ;;
    sol) cmd=(codex exec --dangerously-bypass-approvals-and-sandbox -m gpt-6-sol -c model_reasoning_effort=xhigh "$2") ;;
    probe) cmd=(claude -p "/usage") ;;
  esac
}

# --- rloop's own command line (AGT-1, AGT-2) ------------------------------------------------------
usage() {
  cat <<'EOF'
rloop [OPTIONS] [INSTRUCTION]

  --auto                       run a Sequence (05-sequence.md) instead of one Run
  --manager claude|codex       which Manager preset the pick and judges use   (default: claude)
  --implementer claude|codex   which Implementer preset a Round uses          (default: claude)
  --manager-model MODEL        the Manager's model                       (default: the preset's, AGT-3)
  --implementer-model MODEL    the Implementer's model                   (default: the preset's, AGT-5)
  --base REF                   the ref Reviewers diff against                  (default: HEAD at start)
  --run-dir PATH               the Run Directory, which must not exist yet     (default: DIR-2)
  --max-rounds N               Rounds per Run                                  (default: 10)
  --max-runs N                 Runs per Sequence                               (default: 20)
  --manager-timeout SECONDS    per Manager call                                (default: 3600)
  --implementer-timeout SECONDS  per Implementer call                          (default: 14400)
  --reviewer-timeout SECONDS   per Reviewer call                               (default: 1800)
  --probe-timeout SECONDS      the availability probe's bound (RUN-21)         (default: 60)
  --kill-after SECONDS         SIGTERM-to-SIGKILL grace                        (default: 10)
  --version                    print the Implementation's version and exit 0
  --help                       print this usage and exit 0
EOF
}
err() { printf 'rloop: %s\n' "$*" >&2; }
die() { err "$@"; exit 2; }
number() { # number <flag> <value> <minimum> -> num, the value in base ten (AGT-2: `08` is `8`)
  if ! [[ $2 =~ ^[0-9]+$ ]] || [ "$((10#$2))" -lt "$3" ]; then die "$1 needs a number of at least $3, got '$2'"; fi
  num=$((10#$2))
}

auto=0 manager=claude implementer=claude manager_model=claude-fable-5-1 manager_model_given=0
implementer_model=claude-fable-5-1 implementer_model_given=0 base_ref=HEAD run_dir='' max_rounds=10 max_runs=20
manager_timeout=3600 implementer_timeout=14400 reviewer_timeout=1800 probe_timeout=60 kill_after=10 instruction='' have_instruction=0
inline=0        # the value came from --flag=value, so AGT-2's "next argument begins with --" test does not apply to it
while [ $# -gt 0 ]; do
  case $1 in
    --auto) auto=1; shift ;;
    --version) echo "rloop-bash $version"; exit 0 ;;
    --help) usage; exit 0 ;;
    # AGT-2: a value given with `=` to a flag that takes none is an unknown option, and `--=x`
    # names no flag AGT-1 defines.
    --auto=*|--help=*|--version=*|--=*) die "unknown option $1" ;;
    --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}"; inline=1 ;;
    --manager|--implementer|--manager-model|--implementer-model|--base|--run-dir|--max-rounds|--max-runs|--manager-timeout|--implementer-timeout|--reviewer-timeout|--probe-timeout|--kill-after)
      # AGT-2: the value is missing when the option is last or the next argument begins with `--`.
      if [ $# -lt 2 ] || { [ "$inline" = 0 ] && [ "${2#--}" != "$2" ]; }; then die "$1 needs a value"; fi
      inline=0
      case $1 in
        --manager) case $2 in claude|codex) manager=$2 ;; *) die "--manager takes claude or codex" ;; esac ;;
        --implementer) case $2 in claude|codex) implementer=$2 ;; *) die "--implementer takes claude or codex" ;; esac ;;
        --manager-model) manager_model=$2; manager_model_given=1 ;;
        --implementer-model) implementer_model=$2; implementer_model_given=1 ;;
        --base) base_ref=$2; have_base=1 ;;
        --run-dir) run_dir=$2; have_run_dir=1 ;;
        --max-rounds) number "$1" "$2" 1; max_rounds=$num ;;
        --max-runs) number "$1" "$2" 1; max_runs=$num ;;
        --manager-timeout) number "$1" "$2" 1; manager_timeout=$num ;;
        --implementer-timeout) number "$1" "$2" 1; implementer_timeout=$num ;;
        --reviewer-timeout) number "$1" "$2" 1; reviewer_timeout=$num ;;
        --probe-timeout) number "$1" "$2" 1; probe_timeout=$num ;;
        --kill-after) number "$1" "$2" 1; kill_after=$num ;;
      esac
      shift 2 ;;
    --) shift; break ;;
    -?*) die "unknown option $1" ;;
    *) [ "$have_instruction" = 0 ] || die "more than one INSTRUCTION"; instruction=$1; have_instruction=1; shift ;;
  esac
done
if [ "$manager_model_given" = 0 ] && [ "$manager" = codex ]; then manager_model=gpt-6-astra; fi
if [ "$implementer_model_given" = 0 ] && [ "$implementer" = codex ]; then implementer_model=gpt-6-astra; fi
for arg in "$@"; do [ "$have_instruction" = 0 ] || die "more than one INSTRUCTION"; instruction=$arg; have_instruction=1; done
# SEQ-3 forbids the combination of options, so the test is of each option's presence, not its value.
if [ "$auto" = 1 ] && { [ -n "${have_base:-}" ] || [ -n "${have_run_dir:-}" ]; }; then die "--auto cannot be combined with --base or --run-dir"; fi
case $run_dir in ''|/*) ;; *) run_dir=$PWD/$run_dir ;; esac

# --- the tree (RUN-1) ------------------------------------------------------------------------------
toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git working tree"
[ "$(pwd -P)" = "$toplevel" ] || cd "$toplevel" || die "cannot enter $toplevel"

# --- agents: spawning, timeouts, signals (AGT-12 to AGT-16) ------------------------------------------
live=()          # process groups of running agents (the pid of each agent's `timeout`, its group leader)
interrupted=0
on_signal() {
  if [ "$interrupted" = 1 ]; then [ ${#live[@]} = 0 ] || kill -KILL -- "${live[@]/#/-}" 2>/dev/null; return; fi
  interrupted=1
  err "interrupted"
  [ ${#live[@]} = 0 ] || kill -TERM -- "${live[@]/#/-}" 2>/dev/null
}
trap on_signal INT TERM

group_alive() { kill -0 -- "-$1" 2>/dev/null; }
drain() { # drain [group...]: after an interruption, wait for every live group, SIGKILL after --kill-after, exit 2
  local groups=("${live[@]}" "$@") t=0 any p
  while [ "$t" -lt $((kill_after * 10)) ]; do
    any=0; for p in "${groups[@]}"; do ! group_alive "$p" || any=1; done
    [ "$any" = 1 ] || break
    sleep 0.1; t=$((t + 1))
  done
  for p in "${groups[@]}"; do ! group_alive "$p" || kill -KILL -- "-$p" 2>/dev/null; done
  for p in "${groups[@]}"; do while group_alive "$p"; do sleep 0.1; done; wait "$p" 2>/dev/null; done
  exit 2
}

spawn() { # spawn <role> <round> <reviewer or ""> <timeout> <stdout file> <stderr file> <cmd...> -> pid
  local role=$1 round=$2 reviewer=$3 secs=$4 out=$5 errf=$6; shift 6
  [ "$interrupted" = 0 ] || drain
  local envs=("RLOOP_ROLE=$role" "RLOOP_ROUND=$round" "RLOOP_RUN=$run_n" "RLOOP_RUN_DIR=$run_dir")
  [ -z "$reviewer" ] || envs+=("RLOOP_REVIEWER=$reviewer")
  if [ "$role" = manager ] && [ "$manager" = claude ]; then
    envs+=("BASH_MAX_TIMEOUT_MS=$((manager_timeout * 1000))")
  fi
  env -u RLOOP_REVIEWER "${envs[@]}" timeout -k "$kill_after" "$secs" "$@" </dev/null >"$out" 2>"$errf" &
  pid=$!
  live+=("$pid")
}

sweep() { # sweep <group> (AGT-15): SIGTERM, up to --kill-after for the group to empty, then SIGKILL
  local sig t
  for sig in TERM KILL; do
    group_alive "$1" || return 0
    kill -"$sig" -- "-$1" 2>/dev/null
    for ((t = 0; t < kill_after * 10; t++)); do group_alive "$1" || break; sleep 0.1; done
  done
}

reap() { # reap <pid> -> st, the call's exit status (non-zero on a timeout)
  while :; do
    wait "$1"; st=$?
    kill -0 "$1" 2>/dev/null || break   # still alive: the wait was interrupted by a signal
  done
  reaped "$1"
}

reaped() { # reaped <group...>: AGT-15's reap of each call's group, the processes already waited for
  local p keep=() gone=" $* "
  # AGT-15: the group goes before the step that follows the call, whatever the call's fate --
  # `timeout` reaps only its own child, so a straggler survives a call that ended at the limit
  # too. The caller's status stays the spawned process's.
  # The group stays in `live` across the sweep, so the handler can still reach it: a SIGINT or
  # SIGTERM arriving mid-sweep signals it too, and a second SIGINT SIGKILLs it at once.
  # For a Panel group this is the second sweep -- the wait loop backgrounded the first, for
  # promptness -- and returning from here is what leaves every group empty, which the Checkpoint
  # that follows (RUN-7 step 5) and RUN-15's failure notes both rely on.
  for p; do sweep "$p"; done
  for p in "${live[@]}"; do [[ $gone == *" $p "* ]] || keep+=("$p"); done
  live=("${keep[@]}")
  [ "$interrupted" = 0 ] || drain "$@"
}

note() { # note <file> <line>: append the line on a line of its own
  [ -s "$1" ] && [ -n "$(tail -c1 "$1")" ] && echo >> "$1"
  echo "$2" >> "$1"
}

# --- the Run (01-run-lifecycle.md, 04-run-directory.md) ------------------------------------------------
feedback_files=''
# PRM-6: one pass over the template, so a value substituted in is never scanned again and
# placeholder text inside a value -- an instruction holding {{TASK_FILE}}, a Run Directory path
# holding {{INSTRUCTION}} -- survives byte for byte. A `${t//...}` per placeholder cannot: each
# rescans the values the ones before it inserted. A name no placeholder below owns is emitted as
# it stands, `{{` included.
render() { # render <template> -> stdout, by PRM-6
  local t=$1 out='' name rest
  while [ -n "$t" ]; do
    case $t in *'{{'*) ;; *) out+=$t; break ;; esac
    out+="${t%%'{{'*}"
    rest=${t#*'{{'}
    name=''
    case $rest in *'}}'*) name=${rest%%'}}'*} ;; esac
    case $name in
      INSTRUCTION) out+="$instruction" ;;
      TASK_FILE) out+="$run_dir/task.md" ;;
      FINISHED_FILE) out+="$run_dir/finished.md" ;;
      RUN_DIR) out+="$run_dir" ;;
      BASE) out+="$base" ;;
      ROUND) out+="$round" ;;
      MAX_ROUNDS) out+="$max_rounds" ;;
      IMPLEMENTER_LOG) out+="$run_dir/implementer-$round.out" ;;
      FEEDBACK_FILES) out+="$feedback_files" ;;
      DIRTY_AT_START) out+="$dirty" ;;
      UNAVAILABLE) out+="$unavailable" ;;
      *) out+='{{'; t=$rest; continue ;;
    esac
    t=${rest#*'}}'}
  done
  printf '%s' "$out"
}

end_run() { # end_run <0|1|2|3>: the Run's exit; the Finished File goes to stdout (RUN-10, SEQ-7)
  if [ "$auto" = 1 ]; then
    # SEQ-7: a Run that ended 2 prints nothing, as RUN-10 says of a lone one, Finished File or not.
    if [ "$1" != 2 ]; then echo "== run $run_n =="; cat "$run_dir/finished.md"; fi
    case $1 in 0) return 0 ;; 3) exit 0 ;; *) exit "$1" ;; esac
  fi
  if [ "$1" != 2 ]; then
    cat "$run_dir/finished.md"
    [ "$1" != 0 ] || [ -z "$(git status --porcelain)" ] || err "warning: the Run ended done on a tree that is not clean"
  fi
  exit "$1"
}

decide() { # decide <round, 0 at the pick> <Manager exit> (RUN-11); returns 0 for next Round, 1 when the Run is over
  local r=$1 line=
  [ "$2" = 0 ] || { err "Manager call exited $2"; end_run 2; }
  if [ -e "$run_dir/finished.md" ]; then
    # RUN-9 compares the first line byte for byte, NUL bytes included, and `read` drops those
    # silently: `tr` turns each into SOH first, so a NUL-split status reads as none of the three.
    IFS= read -r line < <(tr '\0' '\1' < "$run_dir/finished.md")
    case $line in
      'STATUS: done') end_run 0; return 1 ;;
      'STATUS: blocked') end_run 1 ;;
      'STATUS: idle') [ "$r" != 0 ] || end_run 3; err "STATUS: idle after a Round"; end_run 2 ;;
      *) err "the Finished File's first line is not a status"; end_run 2 ;;
    esac
  fi
  [ -f "$run_dir/task.md" ] || { err "the Manager wrote neither task.md nor finished.md"; end_run 2; }
  if [ "$r" != 0 ]; then
    ! cmp -s "$run_dir/task.md" "$run_dir/task-$r.md" || { err "no decision: task.md is unchanged and no Finished File"; end_run 2; }
    [ "$r" -lt "$max_rounds" ] || { err "round cap $max_rounds reached; Manager session $sid"; end_run 2; }
  fi
  cp "$run_dir/task.md" "$run_dir/task-$((r + 1)).md" || { err "cannot snapshot task.md"; end_run 2; }
}

checkpoint() { # checkpoint <round> (DIR-6)
  local snap=$run_dir/task-$1.md task=$run_dir/task.md
  [ -f "$snap" ] || { err "snapshot $snap is missing"; end_run 2; }
  if ! cmp -s "$task" "$snap"; then
    [ ! -e "$task" ] || mv -f "$task" "$run_dir/rejected-$1-task.md"
    rm -f "$task"
    cp "$snap" "$task" || { err "cannot restore $task"; end_run 2; }
    err "round $1: task.md was changed by an agent; set aside as rejected-$1-task.md and restored"
  fi
  if [ -e "$run_dir/finished.md" ]; then
    mv -f "$run_dir/finished.md" "$run_dir/rejected-$1-finished.md" || { err "cannot set aside finished.md"; end_run 2; }
    err "round $1: finished.md was written by an agent; set aside as rejected-$1-finished.md"
  fi
}

# RUN-21: read the probe's output and record one verdict per Seat, from that Seat's own model.
# Fail open -- only a zero exit and a line *beginning* `Current week (<family>): 100% used` reads
# `unavailable`; a model off the table (every codex one) has no family and is always `unknown`.
# Matched in the shell, not with grep or sed: neither is on the PATH flake.nix builds, and a
# missing one would read every Seat `unknown` without saying so. The case glob is anchored
# at the start of the line, which is what RUN-21 requires, and each NUL byte becomes SOH before
# the read, which drops one silently: a NUL-split line does not begin with RUN-21's prefix.
is_unavailable() { case $unavail in *" $1 "*) return 0 ;; esac; return 1; }
probe_verdicts() { # probe_verdicts <pick|round> <probe exit status> -> unavail, space-delimited; line_<seat>
  local r=$1 pst=$2 seat model key fam line hit
  unavail=' '
  : > "$run_dir/probe-$r.md"
  for seat in manager implementer fable opus astra sol; do
    # A Reviewer is keyed by its name (its command line fixes its model); the Manager and the
    # Implementer by their models, which take a Reviewer's name only on that Reviewer's model.
    model='' key=$seat
    case $seat in manager) model=$manager_model ;; implementer) model=$implementer_model ;; esac
    case $model in claude-fable-5-1) key=fable ;; claude-opus-5) key=opus ;; esac
    case $key in fable) fam=Fable ;; opus) fam=Opus ;; *) fam='' ;; esac
    hit=''
    if [ "$pst" = 0 ] && [ -n "$fam" ] && [ -f "$run_dir/probe-$r.out" ]; then
      while IFS= read -r line || [ -n "$line" ]; do
        case $line in "Current week ($fam): 100% used"*) hit=$line; break ;; esac
      done < <(tr '\0' '\1' < "$run_dir/probe-$r.out")
    fi
    if [ -n "$hit" ]; then unavail="$unavail$seat "; printf -v "line_$seat" '%s' "$hit"; echo "$seat:unavailable" >> "$run_dir/probe-$r.md"
    else echo "$seat:unknown" >> "$run_dir/probe-$r.md"; fi
  done
}

refuse() { # refuse <seat...> (RUN-22): exit 2 naming each given Seat recorded unavailable, its model and the probe's line
  local s m l n=0
  for s; do
    is_unavailable "$s" || continue
    m=${s}_model l=line_$s n=1
    err "Seat $s cannot answer: model ${!m} is out of quota — ${!l}; pass --$s-model to choose another"
  done
  [ "$n" = 0 ] || end_run 2
}

do_round() { # do_round <round> (RUN-7); returns 0 for next Round, 1 when the Run is over
  round=$1
  local r=$1 rv failed=0 pids=() i out=() keep=() p done_pid rst
  local -A owner=() down=()   # pid -> the Reviewer rloop started; Reviewer -> its non-zero status
  err "run $run_n round $r: implementer"
  agent_cmd implementer "$(render "$implementer_tpl")"
  spawn implementer "$r" "" "$implementer_timeout" "$run_dir/implementer-$r.out" "$run_dir/implementer-$r.err" "${cmd[@]}"
  reap "$pid"
  [ "$st" = 0 ] || note "$run_dir/implementer-$r.out" "IMPLEMENTER FAILED (exit $st)"
  checkpoint "$r"
  err "run $run_n round $r: probe"
  agent_cmd probe
  spawn probe "$r" "" "$probe_timeout" "$run_dir/probe-$r.out" "$run_dir/probe-$r.err" "${cmd[@]}"
  reap "$pid"
  probe_verdicts "$r" "$st"
  err "run $run_n round $r: panel"
  for rv in fable opus astra sol; do
    if is_unavailable "$rv"; then
      # RUN-15: not called, but still a Reviewer of the Panel. rloop writes the file in its place.
      echo "REVIEWER NOT RUN (unavailable)" > "$run_dir/feedback-$r-$rv.md"
      : > "$run_dir/reviewer-$r-$rv.err"
      pids+=("")
      failed=$((failed + 1))
      continue
    fi
    agent_cmd "$rv" "$(render "$review_tpl")"
    spawn reviewer "$r" "$rv" "$reviewer_timeout" "$run_dir/feedback-$r-$rv.md" "$run_dir/reviewer-$r-$rv.err" "${cmd[@]}"
    pids+=("$pid")
  done
  i=0
  for rv in fable opus astra sol; do
    [ -z "${pids[$i]}" ] || { out+=("${pids[$i]}"); owner[${pids[$i]}]=$rv; }
    i=$((i + 1))
  done
  # AGT-15: "Reviewers run concurrently (RUN-8), so each Reviewer's group is reaped as that
  # Reviewer exits" -- completion order, not roster order. Waited for in roster order, a Reviewer
  # that had exited would keep its stragglers writing into the working tree until every Reviewer
  # named before it finished too. `wait -n` names whichever exited; `owner` maps it back.
  while [ ${#out[@]} -gt 0 ]; do
    done_pid=''
    wait -n -p done_pid "${out[@]}"; rst=$?
    # No name means a signal cut the wait short, not that a Reviewer exited: drain if it was ours.
    if [ -z "${done_pid:-}" ]; then [ "$interrupted" = 0 ] || drain; continue; fi
    rv=${owner[$done_pid]}
    keep=(); for p in "${out[@]}"; do [ "$p" = "$done_pid" ] || keep+=("$p"); done; out=("${keep[@]}")
    # AGT-15: this group's grace runs on its own, so the Reviewer that exits next is named and
    # signalled at once rather than a grace late. `reaped` below leaves every group empty.
    sweep "$done_pid" &
    [ "$rst" = 0 ] || { down[$rv]=$rst; failed=$((failed + 1)); }
  done
  # `live` is exactly this Panel's groups: every earlier call's went out of it in that call's own
  # `reaped`, and no Reviewer spawned above has been reaped yet. A `spawn` added between the probe
  # and here without its `reap` would be swept while it still ran.
  reaped "${live[@]}"
  # RUN-15: the notes go on once every group is empty. `spawn` opens a Feedback File without
  # O_APPEND, so a straggler shares its Reviewer's file offset; a note appended while that group
  # still lived would land at the offset, and the straggler's next write would erase the line.
  for rv in "${!down[@]}"; do note "$run_dir/feedback-$r-$rv.md" "REVIEWER FAILED (exit ${down[$rv]})"; done
  checkpoint "$r"
  refuse manager
  [ "$failed" -lt 4 ] || { err "every Reviewer of the Panel is down"; end_run 2; }
  err "run $run_n round $r: judge"
  feedback_files="$run_dir/feedback-$r-fable.md"$'\n'"$run_dir/feedback-$r-opus.md"$'\n'"$run_dir/feedback-$r-astra.md"$'\n'"$run_dir/feedback-$r-sol.md"
  agent_cmd judge "$(render "$judge_tpl")"
  spawn manager "$r" "" "$manager_timeout" "$run_dir/manager-judge-$r.out" "$run_dir/manager-judge-$r.err" "${cmd[@]}"
  reap "$pid"
  decide "$r" "$st"
}

run_once() { # one Run, number run_n; returns only when it ended done inside a Sequence
  local r rv line
  if [ -z "${have_run_dir:-}" ] || [ "$auto" = 1 ]; then
    mkdir -p .rloop/runs || die "cannot create .rloop/runs"
    # DIR-2 wants exactly the two bytes `*` and a newline, `rewriting a file whose bytes differ`.
    # Writing them unconditionally is that, and cheaper than comparing: command substitution
    # strips trailing newlines, so a file of `*` and two, or of `*` and none, read as a match.
    printf '*\n' > .rloop/.gitignore || die "cannot write .rloop/.gitignore"
    run_dir=$PWD/.rloop/runs/$(date -u +%Y%m%dT%H%M%S.%NZ)-$$
  fi
  mkdir "$run_dir" 2>/dev/null || die "cannot create the Run Directory $run_dir (it exists, or its parent does not)"
  err "run $run_n: $run_dir"
  err "run $run_n: pid $$"
  base=$(git rev-parse --verify "$base_ref^{commit}" 2>/dev/null) || die "cannot resolve base $base_ref"
  dirty=$(git status --porcelain) || die "git status failed"
  err "run $run_n: probe"
  agent_cmd probe
  spawn probe 0 "" "$probe_timeout" "$run_dir/probe-pick.out" "$run_dir/probe-pick.err" "${cmd[@]}"
  reap "$pid"
  probe_verdicts pick "$st"
  refuse manager implementer
  unavailable=''
  for rv in fable opus astra sol; do ! is_unavailable "$rv" || unavailable+=${unavailable:+$'\n'}$rv; done
  sid=''
  if [ "$manager" = claude ]; then
    sid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null) || sid=$(uuidgen) || die "cannot generate a session id"
    printf '%s\n' "$sid" > "$run_dir/session" || die "cannot write $run_dir/session"
  fi
  err "run $run_n: pick"
  round=0
  agent_cmd pick "$(render "$pick_tpl")"
  spawn manager 0 "" "$manager_timeout" "$run_dir/manager-pick.out" "$run_dir/manager-pick.err" "${cmd[@]}"
  reap "$pid"
  [ "$st" = 0 ] || decide 0 "$st"
  if [ "$manager" = codex ]; then
    local started='[{,][[:space:]]*"type"[[:space:]]*:[[:space:]]*"thread\.started"[[:space:]]*[,}]'
    local thread_id='[{,][[:space:]]*"thread_id"[[:space:]]*:[[:space:]]*"([^"\\]+)"'
    while IFS= read -r line || [ -n "$line" ]; do
      [[ $line =~ $started ]] || continue
      [[ $line =~ $thread_id ]] && sid=${BASH_REMATCH[1]}
      break
    done < "$run_dir/manager-pick.out"
    [ -n "$sid" ] || die "Manager pick reported no session id"
    printf '%s\n' "$sid" > "$run_dir/session" || die "cannot write $run_dir/session"
  fi
  decide 0 "$st" || return 0
  for ((r = 1; ; r++)); do do_round "$r" || return 0; done
}

if [ "$auto" = 1 ]; then
  for ((run_n = 1; run_n <= max_runs; run_n++)); do
    [ -z "$(git status --porcelain)" ] || die "the tree is not clean before run $run_n"
    run_once
  done
  die "run cap $max_runs reached"
fi
run_n=1
run_once
